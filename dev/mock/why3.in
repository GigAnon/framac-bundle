#!/bin/bash
# MOCK why3 CLI, like the real 1.8.2 (src/tools/main.ml, whyconf.ml):
#  * Config.libdir/datadir: baked build paths, or <exe>/../lib/why3 and
#    <exe>/../share/why3 in a relocatable build (configure --enable-relocation);
#  * sub-commands: Config.libdir/commands/why3<cmd>.cmxs -- WHY3LIB is NOT
#    consulted for them (the bug the 2026-10-08 real run showed);
#  * the library side (drivers, why3server) honours WHY3LIB/WHY3DATA;
#  * provers come from WHY3CONFIG.
if [ "@RELOC@" = yes ]; then
    top=$(dirname "$(dirname "$(readlink -f "$0")")")
    cfg_libdir="$top/lib/why3"; cfg_datadir="$top/share/why3"
else
    cfg_libdir="@WHY3LIB@"; cfg_datadir="@WHY3DATA@"
fi
libdir=${WHY3LIB:-$cfg_libdir}; datadir=${WHY3DATA:-$cfg_datadir}
case "${1:-}" in
  --version) echo "Why3 platform, version 1.8.2"; exit 0;;
  --print-libdir) echo "$cfg_libdir"; exit 0;;
  --print-datadir) echo "$cfg_datadir"; exit 0;;
  "") echo "usage: why3 <command> [options]"; exit 1;;
esac
cmd=$1; shift
[ -d "$cfg_libdir/commands" ] || { echo "anomaly: Sys_error(\"$cfg_libdir/commands: No such file or directory\")"; exit 1; }
[ -f "$cfg_libdir/commands/why3$cmd.cmxs" ] || { echo "why3: unknown command '$cmd'"; exit 1; }
[ -d "$datadir/drivers" ] || { echo "why3: drivers not found in $datadir"; exit 1; }
case "$cmd" in
  config)
    case "${1:-}" in
      detect) { echo '[main]'; echo 'magic = 14'; echo 'datadir = "/should/be/removed"';
         for p in alt-ergo z3 cvc4 cvc5; do b=$(command -v $p) || continue
           case $p in z3) n=Z3;; cvc4) n=CVC4;; cvc5) n=CVC5;; alt-ergo) n=Alt-Ergo;; esac
           printf '\n[partial_prover]\nname = "%s"\npath = "%s"\nversion = "x"\n' $n "$b"; done; } > "$WHY3CONFIG";;
      # real why3 also lists each prover's variants (see logs/why3-provers.txt)
      list-provers) sed -n 's/^name = "\(.*\)"/\1 1.0\n\1 1.0 (counterexamples)/p' "$WHY3CONFIG";;
    esac;;
  prove)
    prover="" file=""
    while [ $# -gt 0 ]; do case "$1" in -P) prover=$2; shift;; -t) shift;; *) file=$1;; esac; shift; done
    path=$(awk -v want="$(echo "$prover" | tr A-Z a-z)" '
        /^name = /{ n=tolower($0); gsub(/^name = "|"$/, "", n) }
        /^path = /{ p=$0; gsub(/^path = "|"$/, "", p); if (n == want) { print p; exit } }' "$WHY3CONFIG")
    [ -n "$path" ] || { echo "why3: no prover '$prover' in $WHY3CONFIG"; exit 1; }
    "$path" --version >/dev/null 2>&1 || { echo "why3: prover $path does not run"; exit 1; }
    out=$("$libdir/why3server" 2>&1); [ "$out" = why3server-ok ] || { echo "why3: why3server failed: $out"; exit 1; }
    [ -f "$file" ] || { echo "why3: no file $file"; exit 1; }
    echo "File $(basename "$file"):"; echo "Goal g."; echo "Prover result is: Valid (0.01s, 3 steps).";;
esac
