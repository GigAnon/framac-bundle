# fcai-completion: bash completion for the offline Frama-C bundle
# (frama-c, ivette, frama-c-script, why3).  Generated at build time from the
# bundled frama-c's own help by lib/gen_completion.py: completing never
# starts frama-c, and this file works outside the AppImage.
#
# Covers what upstream's share/autocomplete_frama-c does (options from
# '-autocomplete @all', -wp-prover from -wp-list-provers, -<plugin>-msg-key /
# -warn-key categories, comma-separated lists, values containing ':') without
# running frama-c on every TAB and without changing COMP_WORDBREAKS.
#
# Enable it per user with setup_completion.sh, or by hand:
#     source <(frama-c --fcai-completion)

_fcai_opts='@OPTS@'
_fcai_argopts=' @ARGOPTS@ '
_fcai_fileopts=' @FILEOPTS@ '
_fcai_script_cmds='@SCRIPT_CMDS@'
_fcai_why3_cmds='@WHY3_CMDS@'
_fcai_why3_provers='@WHY3_PROVERS@'
# option -> accepted values (comma-separated lists for keys and provers)
declare -A _fcai_optvals=(
@OPTVALS@
)

# current and previous words as typed, from COMP_LINE: bash splits words at
# ':' and '=' (COMP_WORDBREAKS), which would break 'native:alt-ergo' or
# 'annot:missing-spec' (upstream removes ':' from COMP_WORDBREAKS for the
# whole shell instead)
_fcai_words() {
    local line
    if [ -n "${COMP_LINE:-}" ]; then
        line=${COMP_LINE:0:${COMP_POINT:-${#COMP_LINE}}}
        local -a w
        read -r -a w <<< "$line"
        if [[ $line == *" " ]]; then
            _fcai_cur="" _fcai_prev=${w[${#w[@]}-1]:-}
        else
            _fcai_cur=${w[${#w[@]}-1]:-} _fcai_prev=${w[${#w[@]}-2]:-}
        fi
    else
        _fcai_cur=${COMP_WORDS[COMP_CWORD]}
        _fcai_prev=""; [ "$COMP_CWORD" -gt 0 ] && _fcai_prev=${COMP_WORDS[COMP_CWORD-1]}
    fi
}

# bash replaces only the part of the word after the last ':' (if ':' is a
# word break): strip what precedes it from the candidates
_fcai_colon_trim() {
    local cur=$1 i
    if [[ $cur == *:* && ${COMP_WORDBREAKS:-:} == *:* ]]; then
        local pre=${cur%"${cur##*:}"}
        for i in "${!COMPREPLY[@]}"; do COMPREPLY[$i]=${COMPREPLY[$i]#"$pre"}; done
    fi
}

# C sources (and the usual Frama-C inputs) plus directories
_fcai_sources() {
    local cur=$1 f
    local IFS=$'\n'
    compopt -o filenames 2>/dev/null
    for f in $(compgen -d -- "$cur"); do COMPREPLY+=("$f"); done
    for f in $(compgen -f -- "$cur"); do
        [ -d "$f" ] && continue
        case "$f" in
            *.c|*.h|*.i|*.ci|*.cc|*.json|*.sav|*.acsl) COMPREPLY+=("$f") ;;
        esac
    done
}

# any file or directory
_fcai_any_file() {
    local IFS=$'\n'
    compopt -o filenames 2>/dev/null
    COMPREPLY+=($(compgen -f -- "$1"))
}

# comma-separated list: complete the last element
_fcai_list() { # WORDS CUR
    local prefix="" last=$2
    case "$2" in *,*) prefix=${2%,*},; last=${2##*,} ;; esac
    COMPREPLY=($(compgen -P "$prefix" -W "$1" -- "$last"))
    compopt -o nospace 2>/dev/null
}

_fcai_frama_c() {
    local _fcai_cur _fcai_prev
    _fcai_words
    local cur=$_fcai_cur prev=$_fcai_prev
    COMPREPLY=()
    case "$_fcai_argopts" in
        *" $prev "*)
            if [ -n "${_fcai_optvals[$prev]+x}" ]; then
                _fcai_list "${_fcai_optvals[$prev]}" "$cur"
            else
                case "$_fcai_fileopts" in *" $prev "*) _fcai_any_file "$cur" ;; esac
            fi
            _fcai_colon_trim "$cur"
            return 0 ;;
    esac
    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$_fcai_opts" -- "$cur"))
    else
        _fcai_sources "$cur"
    fi
}

_fcai_frama_c_script() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    COMPREPLY=()
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W "$_fcai_script_cmds" -- "$cur"))
    elif [ "${COMP_WORDS[1]}" = list-functions ] && [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$_fcai_opts" -- "$cur"))
    else
        _fcai_any_file "$cur"
    fi
}

_fcai_why3() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev="" f
    [ "$COMP_CWORD" -gt 0 ] && prev=${COMP_WORDS[COMP_CWORD-1]}
    COMPREPLY=()
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W "$_fcai_why3_cmds --version --help" -- "$cur"))
    elif [ "$prev" = -P ] || [ "$prev" = --prover ]; then
        COMPREPLY=($(compgen -W "$_fcai_why3_provers" -- "$cur"))
    elif [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "-P --prover -t --timelimit -m --memlimit -L --library -T --theory -G --goal -a --apply-transform -D --driver -o --output --debug --help" -- "$cur"))
    else
        local IFS=$'\n'
        compopt -o filenames 2>/dev/null
        for f in $(compgen -d -- "$cur"); do COMPREPLY+=("$f"); done
        for f in $(compgen -f -- "$cur"); do
            [ -d "$f" ] && continue
            case "$f" in *.why|*.mlw|*.py|*.c|*.smt2|*.p) COMPREPLY+=("$f") ;; esac
        done
    fi
}

complete -F _fcai_frama_c frama-c ivette frama-c-gui
complete -F _fcai_frama_c_script frama-c-script
complete -F _fcai_why3 why3
